# A.I.R.A. (AI Release Assurance) Environment Configuration Example
# Copy this file to .env and configure for your environment

# -----------------------------------------------------------------------------
# A.I.R.A. API & Security Configuration
# -----------------------------------------------------------------------------
# Primary API authentication key required for verification and upload endpoints
AIRA_API_KEY=
# Fallback alias for backwards compatibility
AEGIS_API_KEY=

# CORS Allowed Origins (comma-separated list, e.g. "http://localhost:3000,https://app.example.com")
# When set to wildcard "*", credentials will be automatically disabled to comply with web standards
AIRA_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Rolling Rate Limiter settings for project uploads and verification triggers
AIRA_RATE_LIMIT=30
AIRA_RATE_LIMIT_WINDOW=60

# -----------------------------------------------------------------------------
# Execution & Sandbox Runtime
# -----------------------------------------------------------------------------
# Host and port binding
HOST=0.0.0.0
PORT=8000

# Mode configuration:
# Set to 'false' in production so untrusted code strictly runs in Docker sandboxes.
# If 'false' and Docker is not running, verification endpoints fail-closed (HTTP 503).
# Set to 'true' only for exploring curated static demos without Docker.
DEMO_MODE=false

# Docker sandbox image tag used for isolating test suites
DOCKER_SANDBOX_IMAGE=aegis-sandbox:latest

# -----------------------------------------------------------------------------
# Research & Provider Configuration (SHADOW_MODE_ONLY)
# -----------------------------------------------------------------------------
# Local model execution endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud model providers (used strictly for empirical benchmark baselines)
OPENAI_API_KEY=
GEMINI_API_KEY=
